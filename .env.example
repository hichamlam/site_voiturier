# ─── SUPABASE ───────────────────────────────────────────────
# Créer le projet (SQL Editor → coller supabase/schema.sql → Run),
# puis Settings → API keys pour ces 3 valeurs.
SUPABASE_URL=https://TON_PROJET.supabase.co
SUPABASE_ANON_KEY=COLLER_ICI_LA_CLE_ANON

# ⚠️ Clé "service_role" (Reveal) : accès total à la base.
# Jamais dans le code front, jamais dans git — uniquement dans Vercel.
SUPABASE_SERVICE_ROLE_KEY=COLLER_ICI_LA_SERVICE_ROLE_KEY

# ─── STRIPE ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=COLLER_ICI_TA_CLE_SECRETE_STRIPE   # commence par sk_live_
STRIPE_WEBHOOK_SECRET=COLLER_ICI_LE_SIGNING_SECRET  # commence par whsec_

# ─── RESEND ─────────────────────────────────────────────────
RESEND_API_KEY=COLLER_ICI_TA_CLE_RESEND            # commence par re_
# ⚠️ Le domaine de cette adresse DOIT être vérifié dans Resend, sinon aucun email ne part.
FROM_EMAIL="Voiturier Orly <contact@TON_DOMAINE_VERIFIE_DANS_RESEND>"
ADMIN_EMAIL=ton-email@gmail.com

# ─── SITE ───────────────────────────────────────────────────
SITE_URL=https://www.voiturier-orly.fr

# ─── ADMIN BACK-OFFICE ──────────────────────────────────────
ADMIN_PASSWORD=change_moi_avec_un_mot_de_passe_fort
ADMIN_SESSION_SECRET=change_moi_string_aleatoire_32_chars
